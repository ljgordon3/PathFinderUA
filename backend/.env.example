# Copy this file to .env and adjust values as needed.
# No secrets are required to run PathFinder UA locally -- the MVP does not
# use accounts, passwords, or paid external API keys.

# Comma-separated list of origins allowed to call this API from a browser.
# Must include the URL the Vite dev server prints (default shown below).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Where the curated JSON reference data lives, relative to backend/.
# Change this only if you introduce an alternate dataset (e.g. for a demo).
DATA_DIR=data

# How many ranked recommendations the API returns (US-06 requires 3-5).
RECOMMENDATION_COUNT=5
MIN_RECOMMENDATION_COUNT=3
